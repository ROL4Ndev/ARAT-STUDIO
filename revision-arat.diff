-:root {
-  --color-dark: #111111;
-  --color-white: #ffffff;
-  --color-gray-light: #f5f5f3;
-  --color-gray-mid: #595959;
-  --color-border: #d7d7d3;
-  --color-surface-muted: #eeeeeb;
-  --color-focus: #111111;
-  --color-wa: #25d366;
-  --navbar-h: 72px;
-  --section-py: clamp(3.5rem, 8vw, 6rem);
-  --content-max: 1200px;
-  --text-max: 72ch;
-  --font-size-body: 1rem;
-  --font-size-small: 0.875rem;
-  --space-1: 0.5rem;
-  --space-2: 0.75rem;
-  --space-3: 1rem;
-  --space-4: 1.5rem;
-  --space-5: 2rem;
-  --space-6: 3rem;
-  --transition: 0.2s ease;
-  --font-title: 'Kodchasan', sans-serif;
-  --font-body: Arial, sans-serif;
-}
-
-html, body { margin:0; padding:0; }
-html { scroll-behavior:smooth; }
-
-/* ── Tipografía base: Arial para todo el cuerpo ── */
-*, *::before, *::after { box-sizing:border-box; }
-body {
-  font-family: var(--font-body);
-  font-size:var(--font-size-body); font-weight:400; line-height:1.7;
-  color:var(--color-dark); background-color:var(--color-white);
-  -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
-}
-
-/* ── Kodchasan SOLO para títulos y subtítulos ── */
-h1, h2, h3, h4,
-.section-title,
-.studio-info__title,
-.director-card__name,
-.service-card__title,
-.project-card__title,
-.hero__subtitle,
-.hero__eyebrow,
-.navbar-brand__text,
-.project-overlay__hero-caption h2 {
-  font-family: var(--font-title) !important;
-}
-
-img { max-width:100%; display:block; }
-a   { text-decoration:none; color:inherit; }
-
-:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
-  outline: 3px solid var(--color-focus);
-  outline-offset: 3px;
-}
-
-:where(button, input, select, textarea):disabled,
-:where(button, input, select, textarea)[aria-disabled="true"] {
-  cursor: not-allowed;
-  opacity: 0.65;
-}
-
-main a:not(.btn) {
-  text-decoration: underline;
-  text-underline-offset: 0.16em;
-}
-
-.form-check-label {
-  font-weight: 400;
-}
-
-.btn {
-  min-height: 44px;
-  display: inline-flex;
-  align-items: center;
-  justify-content: center;
-  gap: var(--space-1);
-  font-family: var(--font-body);
-  white-space: normal;
-}
-
-.form-label,
-label {
-  color: var(--color-dark);
-  font-weight: 600;
-}
-
-.form-control,
-.form-select {
-  min-height: 44px;
-  max-width: 100%;
-  font-family: var(--font-body);
-  color: var(--color-dark);
-}
-
-.form-control::placeholder {
-  color: #595959;
-  opacity: 1;
-}
-
-.form-text,
-.text-muted {
-  color: var(--color-gray-mid) !important;
-}
-
-.alert {
-  border-radius: 0;
-  overflow-wrap: anywhere;
-}
-
-.table-responsive {
-  max-width: 100%;
-  overscroll-behavior-inline: contain;
-}
-
-.status-label {
-  display: inline-flex;
-  align-items: center;
-  min-height: 1.75rem;
-  padding: 0.2rem 0.55rem;
-  border: 1px solid currentColor;
-  color: #333333;
-  background: #ffffff;
-  font-size: var(--font-size-small);
-  font-weight: 700;
-  line-height: 1.3;
-  overflow-wrap: anywhere;
-}
-
-.status-label--attention {
-  color: #704500;
-  background: #fff8e6;
-}
-
-.status-label--success {
-  color: #14532d;
-  background: #effaf2;
-}
-
-.status-label--error {
-  color: #8a1c1c;
-  background: #fff1f1;
-}
-
-.status-label--muted {
-  color: #4b4b4b;
-  background: #f3f3f1;
-}
-
-.form-feedback {
-  margin: 0.35rem 0 0;
-  color: #8a1c1c;
-  font-size: var(--font-size-small);
-}
-
-.form-loading {
-  cursor: progress;
-}
-
-/* ══ NAVBAR ══════════════════════════════════════════════════════════ */
-#navbar {
-  background-color: #111111;
-  padding: 0.6rem 0;
-  transition: padding var(--transition), background-color var(--transition);
-  border-bottom: 1px solid transparent;
-}
-#navbar.scrolled {
-  padding: 0.35rem 0;
-  background-color: rgba(14,14,14,0.98);
-  border-bottom-color: rgba(255,255,255,0.07);
-  backdrop-filter: blur(12px);
-  -webkit-backdrop-filter: blur(12px);
-}
-.navbar-brand--combo {
-  display: flex; align-items: center; gap: 0.6rem;
-  text-decoration: none; line-height: 1;
-}
-.navbar-brand__logo {
-  height: 42px; width: auto;
-  filter: brightness(0) invert(1); opacity: 0.92;
-  flex-shrink: 0;
-  transition: opacity var(--transition), height 0.3s ease;
-  display: block;
-}
-#navbar.scrolled .navbar-brand__logo { height: 36px; }
-.navbar-brand--combo:hover .navbar-brand__logo { opacity: 1; }
-
-.navbar-brand__text {
-  font-family: var(--font-title) !important;
-  font-size: 0.88rem; font-weight: 700;
-  letter-spacing: 0.22em; text-transform: uppercase;
-  color: var(--color-white); white-space: nowrap;
-  max-width: 200px; overflow: hidden; opacity: 1;
-  transition: opacity 0.35s ease, max-width 0.35s ease, margin 0.35s ease;
-}
-#navbar.scrolled .navbar-brand__text { opacity:0; max-width:0; margin-left:0; }
-
-.navbar-nav .nav-link {
-  font-family: var(--font-body);
-  color: rgba(255,255,255,0.65) !important;
-  font-size: 0.8rem; font-weight: 400;
-  letter-spacing: 0.06em; text-transform: uppercase;
-  padding: 0.5rem 1rem !important;
-  transition: color var(--transition);
-}
-.navbar-nav .nav-link:hover,
-.navbar-nav .nav-link.active { color: var(--color-white) !important; }
-
-.navbar-toggler { border:none; background:transparent; padding:0.4rem; display:flex; flex-direction:column; gap:5px; }
-.navbar-toggler:focus { box-shadow:none; outline:none; }
-.toggler-icon { display:block; width:24px; height:1.5px; background-color:var(--color-white); transition:transform 0.25s ease,opacity 0.25s ease; }
-
-/* ══ SCROLL MARGINS ══════════════════════════════════════════════════ */
-#inicio    { scroll-margin-top: 0; }
-#sobre     { scroll-margin-top: var(--navbar-h); }
-#servicios { scroll-margin-top: var(--navbar-h); }
-#proyectos { scroll-margin-top: var(--navbar-h); }
-#contacto  { scroll-margin-top: calc(var(--navbar-h) + 50px); }
-
-/* ══ HERO ════════════════════════════════════════════════════════════
-   Sin video activo: fondo sólido oscuro.
-   La clase .hero__video-wrap y .hero__yt-iframe se mantienen en CSS
-   para reactivar sin tocar estilos. Solo descomentar el HTML. */
-.hero {
-  min-height: 100vh;
-  padding-top: var(--navbar-h);
-  background-color: #111111; /* fondo sólido mientras no hay video */
-  position: relative;
-  overflow: hidden;
-}
-
-/* Bloque de video — mantenido en CSS, desactivado en HTML */
-.hero__video-wrap { position:absolute; inset:0; z-index:0; pointer-events:none; overflow:hidden; }
-.hero__yt-iframe {
-  position:absolute; top:50%; left:50%;
-  width:177.78vh; min-width:100%;
-  height:56.25vw; min-height:100%;
-  transform:translate(-50%,-50%);
-  border:none; opacity:0.32;
-}
-.hero__audio-toggle {
-  position:absolute; right:1.5rem; bottom:1.5rem; z-index:4;
-  display:inline-flex; align-items:center; gap:.55rem;
-  padding:.65rem .9rem; border:1px solid rgba(255,255,255,.34);
-  background:rgba(17,17,17,.58); color:rgba(255,255,255,.82);
-  font:500 .68rem var(--font-body); letter-spacing:.06em;
-  cursor:pointer; transition:background-color var(--transition),border-color var(--transition),color var(--transition);
-}
-.hero__audio-toggle:hover,.hero__audio-toggle:focus-visible {
-  border-color:rgba(255,255,255,.75); background:rgba(17,17,17,.88); color:#fff;
-}
-.hero__audio-toggle:focus-visible { outline:2px solid #fff; outline-offset:3px; }
-.hero__audio-toggle i { font-size:.9rem; }
-
-.hero__bg-logo {
-  position:absolute; inset:0; z-index:1;
-  display:flex; align-items:center; justify-content:center;
-  pointer-events:none;
-}
-.hero__bg-logo img {
-  width:clamp(320px,60vw,780px); height:auto;
-  filter:brightness(0) invert(1); opacity:0.04;
-  user-select:none; -webkit-user-select:none;
